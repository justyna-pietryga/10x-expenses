---
import Layout from "@/layouts/Layout.astro";
import AuthenticatedWorkspaceShell from "@/components/AuthenticatedWorkspaceShell.astro";
import Topbar from "@/components/Topbar.astro";
import { BudgetSetup } from "@/components/budget/BudgetSetup";
import { listActiveCategories, loadMonthlyIncome, type BudgetCategory, type MonthlyIncome } from "@/lib/budget/data";
import { createClient } from "@/lib/supabase";
import { validateMonthString } from "@/lib/budget/validation";

const { user } = Astro.locals;
const monthParam = Astro.url.searchParams.get("month");
const fallbackMonth = new Date().toISOString().slice(0, 7);
const selectedMonth = validateMonthString(monthParam ?? fallbackMonth);
const supabase = createClient(Astro.request.headers, Astro.cookies);

let income: MonthlyIncome | null = null;
let categories: BudgetCategory[] = [];
let loadError: string | null = null;

if (supabase && user) {
  try {
    [income, categories] = await Promise.all([
      loadMonthlyIncome(supabase, user.id, selectedMonth),
      listActiveCategories(supabase, user.id),
    ]);
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Could not load budget setup data";
  }
}
---

<Layout title="Budget Setup">
  <main class="bg-cosmic min-h-screen">
    <AuthenticatedWorkspaceShell>
      <Topbar />

      <section
        class="relative overflow-hidden rounded-[36px] border border-white/10 bg-slate-950/45 px-6 py-8 shadow-[0_25px_120px_rgba(15,23,42,0.45)] backdrop-blur-xl sm:px-8"
      >
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-300/60 to-transparent">
        </div>
        <div class="absolute top-[-4rem] -right-20 size-52 rounded-full bg-cyan-400/20 blur-3xl"></div>
        <div class="absolute bottom-[-6rem] -left-16 size-56 rounded-full bg-amber-300/15 blur-3xl"></div>

        <div class="relative z-10">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold tracking-[0.34em] text-cyan-200/70 uppercase">Protected Workspace</p>
              <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
                Budget setup for <span class="text-cyan-200">{selectedMonth.slice(0, 7)}</span>
              </h1>
              <p class="mt-4 max-w-xl text-base leading-7 text-slate-200/75">
                Lock in the month&apos;s income, shape category caps, and keep the active limit total below 100% before
                imports begin.
              </p>
            </div>

            <form
              method="GET"
              class="flex flex-col gap-3 rounded-[28px] border border-white/10 bg-white/7 p-4 sm:flex-row sm:items-end"
            >
              <label class="space-y-2">
                <span class="text-xs font-medium tracking-[0.22em] text-slate-300 uppercase">Selected month</span>
                <input
                  type="month"
                  name="month"
                  value={selectedMonth.slice(0, 7)}
                  class="rounded-2xl border border-white/12 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                />
              </label>
              <button
                type="submit"
                class="h-12 rounded-2xl bg-white/12 px-5 text-sm font-medium text-white transition hover:bg-white/18"
              >
                Switch month
              </button>
            </form>
          </div>

          {
            loadError ? (
              <div class="mt-8 rounded-3xl border border-rose-300/25 bg-rose-400/10 px-5 py-4 text-sm text-rose-100">
                {loadError}
              </div>
            ) : (
              <div class="mt-8">
                <BudgetSetup
                  client:only="react"
                  initialCategories={categories}
                  initialIncome={income}
                  selectedMonth={selectedMonth}
                />
              </div>
            )
          }
        </div>
      </section>
    </AuthenticatedWorkspaceShell>
  </main>
</Layout>
