+    nextUrl.searchParams.delete("batch");
+  }
+
+  window.history.replaceState({}, "", nextUrl);
+}
+
+function didReopenBatch(previousBatch: ImportBatch | null, nextBatch: ImportBatch | null) {
+  return Boolean(previousBatch?.review_completed_at && nextBatch && !nextBatch.review_completed_at);
