+
+function createEmptyStoredBatchReviewState(): StoredBatchReviewState {
+  return {
+    drafts: {},
+    errorById: {},
+    hasDirtyChanges: false,
+    ruleDraftById: {},
+    showExcludedRows: false,
+    successById: {},
+  };
+}
+
+export function getStoredBatchReviewState(
+  stateByBatchId: Partial<Record<string, StoredBatchReviewState>>,
+  batchId: string,
+): StoredBatchReviewState {
+  return stateByBatchId[batchId] ?? createEmptyStoredBatchReviewState();
+}
+
+export function patchStoredBatchReviewStateMap(
+  current: Partial<Record<string, StoredBatchReviewState>>,
+  batchId: string,
+  nextState: Partial<StoredBatchReviewState>,
+) {
+  return {
+    ...current,
+    [batchId]: {
+      ...getStoredBatchReviewState(current, batchId),
+      ...nextState,
+    },
+  };
+}
+
+function syncBatchQueryParam(batchId: string | null) {
+  if (typeof window === "undefined") {
