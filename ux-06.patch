+async function loadOwnedImportBatch(supabase: ImportClient, userId: string, batchId: string) {
+  const { data, error } = await supabase
+    .from("statement_import_batches")
+    .select("*")
+    .eq("id", batchId)
+    .eq("user_id", userId)
+    .single();
+
+  mapPostgrestError(error, "Import batch was not found");
+
+  if (!data) {
+    throw new ImportError("Import batch was not found", { status: 404 });
+  }
+
+  return data;
+}
+
+async function syncBatchReviewStateAfterMutation(supabase: ImportClient, userId: string, batchId: string) {
+  const batch = await loadOwnedImportBatch(supabase, userId, batchId);
+
+  if (!batch.review_completed_at) {
+    return batch;
+  }
+
+  const { data, error } = await supabase
+    .from("statement_import_batches")
+    .update({
+      review_completed_at: null,
+    })
+    .eq("id", batchId)
+    .eq("user_id", userId)
+    .select()
+    .single();
+
+  mapPostgrestError(error, "Import batch was not found");
+
+  if (!data) {
+    throw new ImportError("Import batch was not found", { status: 404 });
+  }
+
+  return data;
+}
+
+async function trySyncBatchReviewStateAfterMutation(supabase: ImportClient, userId: string, batchId: string) {
+  try {
+    return await syncBatchReviewStateAfterMutation(supabase, userId, batchId);
+  } catch (error) {
+    if (error instanceof ImportError && error.status === 404) {
+      return null;
+    }
+
+    throw error;
+  }
+}
+
+export async function listImportBatchSummaries(supabase: ImportClient, userId: string) {
+  const { data: batches, error: batchError } = await supabase
+    .from("statement_import_batches")
+    .select("*")
+    .eq("user_id", userId)
+    .order("imported_at", { ascending: false });
+
+  mapPostgrestError(batchError, "Import batches could not be loaded");
+
+  const importBatches = batches ?? [];
+
+  if (importBatches.length === 0) {
+    return [];
+  }
+
+  const batchIds = importBatches.map((batch) => batch.id);
+  const { data: transactions, error: transactionError } = await supabase
+    .from("transactions")
+    .select("id, import_batch_id")
+    .eq("user_id", userId)
+    .in("import_batch_id", batchIds)
+    .order("transaction_date", { ascending: true });
+
+  mapPostgrestError(transactionError, "Import transactions could not be loaded");
+
+  const rowCountByBatchId = new Map<string, number>();
+
+  for (const transaction of transactions ?? []) {
+    rowCountByBatchId.set(transaction.import_batch_id, (rowCountByBatchId.get(transaction.import_batch_id) ?? 0) + 1);
+  }
+
+  return sortImportBatchSummaries(
+    importBatches.map((batch) => toImportBatchSummary(batch, rowCountByBatchId.get(batch.id) ?? 0)),
+  );
+}
