+export function upsertImportBatchSummary(
+  summaries: ImportBatchSummary[],
+  batch: ImportBatch,
+  rowCount: number,
+): ImportBatchSummary[] {
+  const nextSummary = toImportBatchSummary(batch, rowCount);
+  const withoutCurrent = summaries.filter((summary) => summary.id !== batch.id);
+
+  return sortImportBatchSummaries([...withoutCurrent, nextSummary]);
